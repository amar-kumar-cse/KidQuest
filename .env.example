# ==============================================================================
# KidQuest — Unified Environment Variables Template
# ==============================================================================
# For Mobile Local Development:
#   cp .env.example .env
#   cp .env.example Frontend/.env
#
# For Cloud Functions Local Development:
#   cp .env.example Backend/functions/.env
#
# ⚠️ SECURITY WARNING: NEVER commit `.env` or files with active keys to Git!
# `EXPO_PUBLIC_*` variables are bundled directly into client app code and can
# be viewed by anyone inspecting the bundle. Keep sensitive secrets on server!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Non-Secret)
# ------------------------------------------------------------------------------
# Obtain from: Firebase Console → Project Settings → General → "Your apps" (Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kidquest-45298.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kidquest-45298
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=kidquest-45298.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=255548121122
EXPO_PUBLIC_FIREBASE_APP_ID=1:255548121122:web:abcdef1234567890
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Mobile App Runtime Environment & Local Emulators
# ------------------------------------------------------------------------------
# Options: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Set to 'true' during local emulator testing (points to 127.0.0.1 / 10.0.2.2)
# Set to 'false' to connect to live Firebase Cloud project
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# 3. EAS Build & Mobile Distribution (Expo Application Services)
# ------------------------------------------------------------------------------
# Obtain by running `npx eas project:init` inside Frontend/
# or at https://expo.dev/accounts/[username]/projects/kidquest
EAS_PROJECT_ID=your-eas-project-id-uuid

# ------------------------------------------------------------------------------
# 4. Sentry Crash Reporting & Performance Monitoring
# ------------------------------------------------------------------------------
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=kidquest
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ------------------------------------------------------------------------------
# 5. Cloud Functions Configuration & Secrets
# ------------------------------------------------------------------------------
# In production, set secrets via Firebase CLI (Stored in Google Cloud Secret Manager):
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set SENDGRID_API_KEY
#
# For local emulators, keep them in Backend/functions/.env (Gitignored):
APP_ENV=development
PROJECT_REGION=asia-south1

# Google Generative AI (Gemini Flash for task suggestions & vision proof verification)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SendGrid / SMTP for weekly parent PDF report emails
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS="KidQuest Progress" <reports@kidquest.app>

# Application URLs
APP_WEB_URL=https://kidquest-45298.web.app
SCHOOL_PORTAL_URL=https://kidquest-portal.web.app

# Gamification & Notification Guardrails
DEFAULT_REWARD_XP=50
MAX_DAILY_QUEST_LIMIT=20
STREAK_GRACE_PERIOD_HOURS=24
PUSH_NOTIFICATION_BATCH_SIZE=500
