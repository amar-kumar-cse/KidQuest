# ==============================================================================
# KidQuest — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` (root) and `Frontend/.env` for local mobile development:
#   cp .env.example .env
#   cp .env.example Frontend/.env
#
# ⚠️ NEVER commit `.env` or any file containing real API keys / credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Non-Secret)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console → Project Settings → General → "Your apps" (Web)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Application Runtime Environment
# ------------------------------------------------------------------------------
# Options: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Set to true to force connection to local Firebase emulators in development
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# 3. Expo Application Services (EAS)
# ------------------------------------------------------------------------------
# Get your Project ID by running `npx eas project:init` inside Frontend/
# or from https://expo.dev/accounts/[username]/projects
EAS_PROJECT_ID=your-eas-project-id-uuid

# ------------------------------------------------------------------------------
# 4. Sentry (Error Tracking & Crash Reporting)
# ------------------------------------------------------------------------------
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=kidquest
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ------------------------------------------------------------------------------
# 5. Server-Side Secrets (Cloud Functions ONLY — NEVER expose to EXPO_PUBLIC_!)
# ------------------------------------------------------------------------------
# Set in Google Cloud Secret Manager or Backend/functions/.env:
#   firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
SENDGRID_API_KEY=your_sendgrid_api_key_for_weekly_reports
EMAIL_FROM_ADDRESS="KidQuest Progress" <reports@kidquest.app>
