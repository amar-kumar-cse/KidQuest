rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // HELPER FUNCTIONS & ROLE CHECKERS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function currentUserData() {
      return getUserData(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (userDocExists(request.auth.uid) && currentUserData().get('role', '') == 'admin')
      );
    }

    function isParent() {
      return isSignedIn() && userDocExists(request.auth.uid) && currentUserData().get('role', '') == 'parent';
    }

    function isTeacher() {
      return isSignedIn() && userDocExists(request.auth.uid) && currentUserData().get('role', '') == 'teacher';
    }

    function isParentOf(childUid) {
      return isParent() &&
        ('parentOf' in currentUserData()) &&
        currentUserData().parentOf.hasAny([childUid]);
    }

    function isTeacherOf(studentUid) {
      return isTeacher() &&
        ('teacherOf' in currentUserData()) &&
        currentUserData().teacherOf.hasAny([studentUid]);
    }

    // Rate-limiting / DoS prevention via document payload bounds
    function isValidDocSize(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    // =====================================================================
    // USERS COLLECTION: users/{uid}
    // Fields: role ('child'|'parent'|'teacher'|'admin'), name, email, parentOf[], teacherOf[]
    // =====================================================================
    match /users/{userId} {
      allow read: if isAdmin()
        || isUser(userId)
        || isParentOf(userId)
        || isTeacherOf(userId);

      allow create: if isAdmin() || (
        isUser(userId)
        && isValidDocSize(15)
        && request.resource.data.keys().hasAll(['role', 'name', 'createdAt'])
        && request.resource.data.role in ['child', 'parent', 'teacher']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && (!('parentOf' in request.resource.data) || request.resource.data.parentOf is list)
        && (!('teacherOf' in request.resource.data) || request.resource.data.teacherOf is list)
      );

      // User CANNOT modify their own role. Only admin can modify roles.
      allow update: if isAdmin() || (
        isUser(userId)
        && isValidDocSize(15)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        // Children cannot alter parentOf or teacherOf relations
        && (resource.data.role != 'child' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentOf', 'teacherOf']))
      );

      allow delete: if isAdmin() || isUser(userId);
    }

    // =====================================================================
    // TASKS COLLECTION: tasks/{taskId}
    // Fields: userId, subject, status ('pending'|'done'|'missed'), completedAt
    // =====================================================================
    match /tasks/{taskId} {
      function isValidTaskPayload() {
        return isValidDocSize(20)
          && request.resource.data.keys().hasAll(['userId', 'subject', 'status', 'createdAt'])
          && request.resource.data.userId is string
          && request.resource.data.subject is string
          && request.resource.data.subject.size() >= 1
          && request.resource.data.subject.size() <= 100
          && request.resource.data.status in ['pending', 'done', 'missed']
          && (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp)
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200));
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || isParentOf(resource.data.userId)
        || isTeacherOf(resource.data.userId);

      // Child can create own task; Teacher can create tasks for their students.
      // Parents CANNOT create or assign tasks directly.
      allow create: if isAdmin() || (
        isValidTaskPayload() && (
          (request.auth.uid == request.resource.data.userId) ||
          isTeacherOf(request.resource.data.userId)
        )
      );

      // Child can update own task status; Teacher can update assignments for their students.
      // Parents CANNOT modify child's tasks directly.
      // Task userId cannot be changed (reassigned to another kid).
      allow update: if isAdmin() || (
        isValidTaskPayload()
        && request.resource.data.userId == resource.data.userId
        && (
          (request.auth.uid == resource.data.userId) ||
          isTeacherOf(resource.data.userId)
        )
      );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'pending')
        || isTeacherOf(resource.data.userId);
    }

    // =====================================================================
    // STREAKS COLLECTION: streaks/{userId}
    // =====================================================================
    match /streaks/{userId} {
      allow read: if isAdmin()
        || isUser(userId)
        || isParentOf(userId)
        || isTeacherOf(userId);

      // Parents CANNOT modify streaks. Only user or admin can write.
      allow write: if isAdmin() || (
        isUser(userId)
        && isValidDocSize(10)
        && request.resource.data.keys().hasAll(['currentStreak', 'bestStreak', 'updatedAt'])
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 0
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= 0
      );
    }

    // =====================================================================
    // REWARDS COLLECTION: rewards/{userId}
    // =====================================================================
    match /rewards/{userId} {
      allow read: if isAdmin()
        || isUser(userId)
        || isParentOf(userId)
        || isTeacherOf(userId);

      // Parents CANNOT modify rewards directly (rewards are claimed via transactions/functions or child store)
      allow write: if isAdmin() || (
        isUser(userId)
        && isValidDocSize(15)
        && (!('balance' in request.resource.data) || (request.resource.data.balance is int && request.resource.data.balance >= 0))
      );
    }

    // =====================================================================
    // SUGGESTIONS COLLECTION: suggestions/{userId}
    // AI generated — Read-only for User and Parent. Client write is FORBIDDEN.
    // Writes happen strictly through Firebase Admin SDK (Cloud Functions).
    // =====================================================================
    match /suggestions/{userId} {
      allow read: if isAdmin()
        || isUser(userId)
        || isParentOf(userId);

      allow write: if isAdmin();
    }

    // =====================================================================
    // NOTIFICATIONS COLLECTION: notifications/{userId}/items/{notifId}
    // Strictly private to the individual user.
    // =====================================================================
    match /notifications/{userId} {
      allow read, write: if isAdmin() || isUser(userId);

      match /items/{notifId} {
        allow read: if isAdmin() || isUser(userId);

        allow create: if isAdmin() || (
          isUser(userId)
          && isValidDocSize(10)
          && request.resource.data.keys().hasAll(['title', 'body', 'read', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 150
          && request.resource.data.read is bool
        );

        allow update: if isAdmin() || (
          isUser(userId)
          && isValidDocSize(10)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        );

        allow delete: if isAdmin() || isUser(userId);
      }
    }

    // =====================================================================
    // DEFAULT DENY FOR ALL OTHER COLLECTIONS
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
