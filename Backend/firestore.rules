rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // HELPER FUNCTIONS & ROLE CHECKERS (CUSTOM CLAIMS + FIRESTORE FALLBACK)
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Role helpers with custom claims first (fast & 0 read cost), fallback to Users/{uid}
    function hasRole(roleName) {
      return isSignedIn() && (
        request.auth.token.get('role', '') == roleName ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('role', '') == roleName) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == roleName)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        hasRole('admin')
      );
    }

    function isParent() {
      return hasRole('parent');
    }

    function isKid() {
      return hasRole('kid');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function getUserData(uid) {
      return exists(/databases/$(database)/documents/Users/$(uid))
        ? get(/databases/$(database)/documents/Users/$(uid)).data
        : get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isParentOf(childUid) {
      return isParent() && (
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         'linkedKids' in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data &&
         childUid in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.linkedKids) ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         'parentOf' in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.parentOf.hasAny([childUid])) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'parentOf' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parentOf.hasAny([childUid]))
      );
    }

    function isTeacherOf(studentUid) {
      return isTeacher() && (
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         'teacherOf' in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.teacherOf.hasAny([studentUid])) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'teacherOf' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherOf.hasAny([studentUid]))
      );
    }

    function isValidDocSize(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    // =====================================================================
    // 1. USERS COLLECTION: Users/{userId} & users/{userId} (Legacy alias)
    // =====================================================================
    match /Users/{userId} {
      allow read: if isAdmin()
        || isUser(userId)
        || isParentOf(userId)
        || isTeacherOf(userId);

      // Parent can register themselves or create child profile
      allow create: if isAdmin() || (
        isValidDocSize(20) &&
        (
          // Parent registering self
          (isUser(userId) && request.resource.data.get('role', '') in ['parent', 'teacher']) ||
          // Parent creating a linked child profile
          (isParent() && request.resource.data.get('role', '') == 'kid' && request.resource.data.get('linkedParentId', '') == request.auth.uid) ||
          // Child auth signup (transition flow)
          (isUser(userId) && request.resource.data.get('role', '') in ['kid', 'child'])
        ) &&
        request.resource.data.get('name', '') is string &&
        request.resource.data.get('name', '').size() >= 1 &&
        request.resource.data.get('name', '').size() <= 80
      );

      // Updating profile: Anti-tamper on role, XP, streak & family links
      allow update: if isAdmin() || (
        (isUser(userId) || isParentOf(userId)) &&
        isValidDocSize(25) &&
        // ROLE IMMUTABILITY: Users cannot promote themselves or change roles
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
        // CLIENT ANTI-CHEAT: Client cannot directly alter XP or streak in user document!
        // Only Cloud Functions via Admin SDK can award XP or update streaks.
        (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalXp', 'lifetimeXp', 'level', 'currentStreak', 'bestStreak'])) &&
        // Children cannot alter parent/teacher relations
        (resource.data.get('role', '') != 'kid' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedParentId', 'parentOf', 'teacherOf']))
      );

      allow delete: if isAdmin() || isUser(userId) || isParentOf(userId);
    }

    // Legacy lowercase alias for backward compatibility
    match /users/{userId} {
      allow read: if isAdmin() || isUser(userId) || isParentOf(userId) || isTeacherOf(userId);
      allow create, update: if isAdmin() || isUser(userId) || isParentOf(userId);
      allow delete: if isAdmin() || isUser(userId) || isParentOf(userId);
    }

    // =====================================================================
    // 2. TASKS COLLECTION: Tasks/{taskId} & tasks/{taskId}
    // Fields: title, description, category, difficulty, xp, assignedToUid, parentId, status
    // =====================================================================
    match /Tasks/{taskId} {
      function isValidTaskPayload() {
        return isValidDocSize(25) &&
          request.resource.data.keys().hasAll(['title', 'category', 'difficulty', 'xp', 'assignedToUid', 'parentId', 'status']) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() >= 2 &&
          request.resource.data.title.size() <= 120 &&
          request.resource.data.category in ['homework', 'chores', 'reading', 'exercise', 'creative', 'kindness', 'other'] &&
          request.resource.data.difficulty in ['easy', 'medium', 'hard'] &&
          request.resource.data.xp is int &&
          request.resource.data.xp >= 5 &&
          request.resource.data.xp <= 1000 &&
          request.resource.data.status in ['pending', 'pending_approval', 'completed', 'rejected'];
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.assignedToUid == request.auth.uid)
        || (isSignedIn() && resource.data.parentId == request.auth.uid)
        || isParentOf(resource.data.assignedToUid)
        || isTeacherOf(resource.data.assignedToUid);

      // Parent can create task for their child; Teacher for their student; Child for self
      allow create: if isAdmin() || (
        isValidTaskPayload() && (
          // Parent assigning to their kid
          (isParent() && request.auth.uid == request.resource.data.parentId) ||
          // Teacher assigning to their student
          (isTeacher() && request.auth.uid == request.resource.data.parentId) ||
          // Child self-assigning a personal habit/task
          (isKid() && request.auth.uid == request.resource.data.assignedToUid)
        )
      );

      // Update flow:
      // - Child can submit proof (status -> pending_approval)
      // - Parent can approve/reject (status -> completed / rejected)
      // - Child CANNOT directly mark task completed (prevents self-approval exploit)
      allow update: if isAdmin() || (
        isValidDocSize(25) &&
        (
          // Parent approving/rejecting or editing their task
          (request.auth.uid == resource.data.parentId) ||
          // Child submitting proof for their assigned task
          (
            request.auth.uid == resource.data.assignedToUid &&
            // Child cannot change core assignment fields
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToUid', 'parentId', 'xp', 'difficulty', 'category']) &&
            // Child can only change status to 'pending_approval' or keep 'pending', NEVER 'completed'
            request.resource.data.status in ['pending', 'pending_approval']
          ) ||
          // Teacher managing task
          isTeacherOf(resource.data.assignedToUid)
        )
      );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.parentId == request.auth.uid)
        || (isSignedIn() && resource.data.assignedToUid == request.auth.uid && resource.data.status == 'pending');
    }

    // Legacy lowercase tasks alias
    match /tasks/{taskId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.get('assignedToUid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid))
        || (isSignedIn() && resource.data.get('parentId', '') == request.auth.uid)
        || isParentOf(resource.data.get('assignedToUid', resource.data.get('userId', '')));

      allow create, update, delete: if isAdmin()
        || (isSignedIn() && (request.resource.data.get('parentId', '') == request.auth.uid || request.auth.uid == resource.data.get('parentId', '')))
        || (isSignedIn() && (request.resource.data.get('assignedToUid', '') == request.auth.uid || resource.data.get('assignedToUid', '') == request.auth.uid));
    }

    // =====================================================================
    // 3. TASK SUBMISSIONS (AUDIT TRAIL): TaskSubmissions/{submissionId}
    // =====================================================================
    match /TaskSubmissions/{submissionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.childUid == request.auth.uid)
        || (isSignedIn() && resource.data.parentId == request.auth.uid)
        || isParentOf(resource.data.childUid);

      // Child uploads proof
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.childUid == request.auth.uid &&
        isValidDocSize(15)
      );

      // Parent reviews submission
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.parentId == request.auth.uid &&
        isValidDocSize(15)
      );

      allow delete: if isAdmin();
    }

    // =====================================================================
    // 4. REWARDS COLLECTION: Rewards/{rewardId}
    // =====================================================================
    match /Rewards/{rewardId} {
      allow read: if isSignedIn();

      // Only parent can create or manage their family rewards catalog
      allow create: if isAdmin() || (
        isParent() &&
        request.resource.data.parentId == request.auth.uid &&
        isValidDocSize(12) &&
        request.resource.data.title is string &&
        request.resource.data.costXp is int &&
        request.resource.data.costXp >= 10
      );

      allow update, delete: if isAdmin() || (
        isParent() &&
        resource.data.parentId == request.auth.uid
      );
    }

    // =====================================================================
    // 5. REWARD CLAIMS: RewardClaims/{claimId}
    // =====================================================================
    match /RewardClaims/{claimId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.kidId == request.auth.uid)
        || (isSignedIn() && resource.data.parentId == request.auth.uid)
        || isParentOf(resource.data.kidId);

      // Child requests reward claim
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.kidId == request.auth.uid &&
        isValidDocSize(15)
      );

      // Parent approves or rejects claim
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.parentId == request.auth.uid &&
        isValidDocSize(15)
      );

      allow delete: if isAdmin();
    }

    // =====================================================================
    // 6. XP LEDGER (SERVER-AUTHORITATIVE AUDIT): XpLedger/{entryId}
    // Client write is strictly FORBIDDEN. Only Cloud Functions Admin SDK can write.
    // =====================================================================
    match /XpLedger/{entryId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.kidUid == request.auth.uid)
        || (isSignedIn() && resource.data.parentId == request.auth.uid)
        || isParentOf(resource.data.kidUid);

      allow write: if isAdmin(); // Cloud Functions uses Admin SDK which bypasses rules
    }

    // =====================================================================
    // 7. FAMILY CODES: FamilyCodes/{code}
    // =====================================================================
    match /FamilyCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isParent() && request.resource.data.parentId == request.auth.uid;
      allow update, delete: if isParent() && resource.data.parentId == request.auth.uid;
    }

    // =====================================================================
    // 8. NOTIFICATIONS COLLECTION: Notifications/{notifId}
    // =====================================================================
    match /Notifications/{notifId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.recipientId == request.auth.uid);

      allow create: if isSignedIn() && isValidDocSize(12);

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.recipientId == request.auth.uid &&
        // Recipient can only mark read/unread
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'read'])
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
    }

    // =====================================================================
    // 9. SCHOOLS & CLASSES (School Portal): Schools/{schoolId}
    // =====================================================================
    // Direct root Classes collection (School Portal): Classes/{classId}
    match /Classes/{classId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherUid == request.auth.uid ||
        (isKid() && request.auth.uid in resource.data.studentUids)
      );

      allow create: if isAdmin() || (
        isTeacher() && request.resource.data.teacherUid == request.auth.uid
      );

      allow update, delete: if isAdmin() || (
        isTeacher() && resource.data.teacherUid == request.auth.uid
      );
    }

    match /Schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /Classes/{classId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          resource.data.teacherUid == request.auth.uid ||
          (isKid() && request.auth.uid in resource.data.studentUids)
        );

        allow write: if isAdmin() || (
          isTeacher() && (
            resource.data.teacherUid == request.auth.uid ||
            request.resource.data.teacherUid == request.auth.uid
          )
        );
      }
    }

    // =====================================================================
    // 10. AI SUGGESTIONS: suggestions/{userId} & AISuggestions/{id}
    // Read-only for User and Parent. Client write is FORBIDDEN.
    // =====================================================================
    match /suggestions/{userId} {
      allow read: if isAdmin() || isUser(userId) || isParentOf(userId);
      allow write: if isAdmin();
    }

    match /AISuggestions/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.requestedBy == request.auth.uid)
        || isParentOf(resource.data.requestedBy);
      allow write: if isAdmin();
    }

    // =====================================================================
    // DEFAULT DENY FOR ALL OTHER COLLECTIONS
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
