# ==============================================================================
# KidQuest Cloud Functions Environment Configuration
# ==============================================================================
# NOTE: Only NON-SENSITIVE variables should be placed in .env files.
# SENSITIVE keys (Stripe secret, OpenAI key, JWT secret, etc.) MUST be stored
# in Google Cloud Secret Manager using:
#   firebase functions:secrets:set SECRET_NAME
# ==============================================================================

# General Environment
APP_ENV=production
PROJECT_REGION=us-central1

# Application URLs
APP_WEB_URL=https://kidquest-app.web.app
SCHOOL_PORTAL_URL=https://kidquest-portal.web.app

# Routine & Task Defaults
DEFAULT_REWARD_XP=50
MAX_DAILY_QUEST_LIMIT=20
STREAK_GRACE_PERIOD_HOURS=24

# Notification Settings
PUSH_NOTIFICATION_BATCH_SIZE=500
