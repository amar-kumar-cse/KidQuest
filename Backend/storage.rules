rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // Maximum 5 MB, image MIME type only
    function isValidPhoto() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // =====================================================================
    // PROFILE PHOTOS: profile-photos/{userId}/{fileName}
    // Users can only upload to their own directory.
    // =====================================================================
    match /profile-photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isUser(userId) || isAdmin()) && isValidPhoto();
      allow delete: if isUser(userId) || isAdmin();
    }

    // =====================================================================
    // TASK PHOTOS: task-photos/{taskId}/{fileName}
    // Only the task owner (userId stored in Firestore tasks/{taskId}) can write.
    // =====================================================================
    match /task-photos/{taskId}/{fileName} {
      // Lookup the task owner in Firestore
      function isTaskOwner() {
        return request.auth.uid == firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.userId;
      }

      allow read: if isSignedIn();
      allow write: if (isSignedIn() && isTaskOwner() && isValidPhoto()) || isAdmin();
      allow delete: if (isSignedIn() && isTaskOwner()) || isAdmin();
    }

    // =====================================================================
    // DEFAULT DENY
    // =====================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
