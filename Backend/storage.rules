rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================================
    // HELPER FUNCTIONS & VALIDATORS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    // Maximum file size & image MIME validation
    function isValidPhoto(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Task document lookup in Firestore (PascalCase primary, lowercase fallback)
    function hasTask(taskId) {
      return firestore.exists(/databases/(default)/documents/Tasks/$(taskId)) ||
             firestore.exists(/databases/(default)/documents/tasks/$(taskId));
    }

    function getTaskData(taskId) {
      return firestore.exists(/databases/(default)/documents/Tasks/$(taskId))
        ? firestore.get(/databases/(default)/documents/Tasks/$(taskId)).data
        : firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
    }

    function isTaskParty(taskId) {
      return isSignedIn() && hasTask(taskId) && (
        request.auth.uid == getTaskData(taskId).get('assignedToUid', '') ||
        request.auth.uid == getTaskData(taskId).get('userId', '') ||
        request.auth.uid == getTaskData(taskId).get('parentId', '')
      );
    }

    // =====================================================================
    // 1. PROFILE PHOTOS: profile-photos/{userId}/{fileName}
    // Readable by self, linked parent, or admin. NO PUBLIC READ.
    // Max 5 MB, image MIME type only.
    // =====================================================================
    match /profile-photos/{userId}/{fileName} {
      allow read: if isSignedIn() && (
        isUser(userId) ||
        (firestore.exists(/databases/(default)/documents/Users/$(request.auth.uid)) &&
         userId in firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.get('linkedKids', [])) ||
        isAdmin()
      );
      allow write: if (isUser(userId) || isAdmin()) && isValidPhoto(5 * 1024 * 1024);
      allow delete: if isUser(userId) || isAdmin();
    }

    // =====================================================================
    // 2. TASK PROOF PHOTOS: task-photos/{taskId}/{fileName}
    // Child upload proof of chore/homework.
    // Strictly restricted to assigned child and parent. COPPA/DPDP compliant.
    // Max 10 MB, image MIME type only.
    // =====================================================================
    match /task-photos/{taskId}/{fileName} {
      allow read: if isTaskParty(taskId) || isAdmin();
      allow write: if (isTaskParty(taskId) || isAdmin()) && isValidPhoto(10 * 1024 * 1024);
      allow delete: if isTaskParty(taskId) || isAdmin();
    }

    // =====================================================================
    // DEFAULT DENY FOR ALL OTHER PATHS
    // =====================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
