{
  "name": "kidquest-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "frontend:start": "cd Frontend && npm run start",
    "frontend:ios": "cd Frontend && npm run ios",
    "frontend:android": "cd Frontend && npm run android",
    "frontend:typecheck": "cd Frontend && npm run type-check",
    "backend:build": "npm --prefix Backend/functions run build",
    "backend:deploy": "npm run backend:build && firebase deploy --only functions",
    "deploy:all": "npm run backend:build && cd school-portal && npm run build && cd .. && firebase deploy",
    "emulate": "firebase emulators:start",
    "backend:functions:build": "npm --prefix Backend/functions run build",
    "backend:functions:serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "test": "cd Frontend && npm run test",
    "test:coverage": "cd Frontend && npm run test:coverage",
    "test:watch": "cd Frontend && npm run test:watch",
    "test:rules": "firebase emulators:exec --only firestore \"npm --prefix Backend test\"",
    "dev": "concurrently \"npm:frontend:start\" \"npm:emulate\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
