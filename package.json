{
  "name": "kidquest-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Frontend",
    "school-portal",
    "Backend/functions"
  ],
  "scripts": {
    "frontend:start": "npm --prefix Frontend run start",
    "frontend:ios": "npm --prefix Frontend run ios",
    "frontend:android": "npm --prefix Frontend run android",
    "frontend:typecheck": "npm --prefix Frontend run type-check",
    "portal:dev": "npm --prefix school-portal run dev",
    "portal:build": "npm --prefix school-portal run build",
    "backend:build": "npm --prefix Backend/functions run build",
    "backend:deploy": "npm run backend:build && firebase deploy --only functions",
    "deploy:all": "npm run backend:build && npm run portal:build && firebase deploy",
    "emulate": "firebase emulators:start",
    "backend:functions:build": "npm --prefix Backend/functions run build",
    "backend:functions:serve": "firebase emulators:start --only functions,firestore,auth,storage,database",
    "test": "npm --prefix Frontend run test",
    "test:coverage": "npm --prefix Frontend run test:coverage",
    "test:watch": "npm --prefix Frontend run test:watch",
    "lint": "npm --prefix Frontend run lint && npm --prefix school-portal run lint",
    "typecheck": "npm --prefix Frontend run type-check && npm --prefix Backend/functions run build && npm --prefix school-portal run build",
    "format": "npm --prefix Frontend run format",
    "dev": "concurrently \"npm:frontend:start\" \"npm:emulate\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
